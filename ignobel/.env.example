# Copy to .env and fill in. Never commit .env.
MOCK=1                      # 1 = no network, fake LLM/search/sandbox
OPENAI_API_KEY=
MODEL_CHEAP=gpt-5-mini
MODEL_STRONG=gpt-5
MODEL_JUDGE_B=gpt-5-mini
EMBED_MODEL=text-embedding-3-small
EXA_KEYS=                   # comma-separated, rotated per call (EXA_API_KEY also accepted)
EXA_MAX_CALLS=500
PAST_API_KEY=
PAST_BASE_URL=https://api.past.dev
TOKEN_CAP=0                 # total tokens per process, 0 = unlimited
