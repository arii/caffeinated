# Copy to .env and fill in. Never commit .env.
MOCK=1                      # 1 = fake LLM/search; studies run in local Docker instead of Modal
IGNOBEL_SANDBOX=             # docker|modal; default docker when MOCK=1, modal otherwise
IGNOBEL_SANDBOX_IMAGE=       # Docker image for studies; default python:3.11-slim when MOCK=1, the numpy/pandas/scipy image otherwise
OPENAI_API_KEY=              # comma-separated keys take turns; rejected/out-of-credit keys are dropped
OPENAI_BASE_URL=             # any OpenAI-compatible endpoint, e.g. Tinker: https://tinker.thinkingmachines.dev/services/tinker-prod/oai/api/v1
MODEL_CHEAP=gpt-5-mini
MODEL_STRONG=gpt-5
MODEL_JUDGE_B=gpt-5-mini
EMBED_BACKEND=openai        # local = fastembed on CPU (no key); use when the chat provider has no embeddings
EMBED_MODEL=text-embedding-3-small  # local default: BAAI/bge-small-en-v1.5
EXA_KEYS=                   # comma-separated, rotated per call (EXA_API_KEY also accepted)
EXA_MAX_CALLS=500
PAST_API_KEY=
PAST_BASE_URL=https://api.past.dev
TOKEN_CAP=0
REASONING_TOKENS=0           # extra completion budget per call for reasoning models (Tinker Inkling: 2000)                 # total tokens per process, 0 = unlimited
